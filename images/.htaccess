# Dossier de fichiers envoyés : ni listing, ni exécution de script (même en double extension, ex. image.php.jpg)
Options -Indexes

<FilesMatch "\.(php[0-9]?|pht|phtml|phar|pl|py|cgi|sh|shtml|asp|aspx|jsp)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
