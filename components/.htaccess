# Pas de listing du contenu des dossiers
Options -Indexes

# Anciennes copies, archives de code et fichiers système : jamais servis
<FilesMatch "(^_index\.php|\.zip|\.DS_Store)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
